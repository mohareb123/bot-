# === Telegram Bot ===
BOT_TOKEN=your_telegram_bot_token_here
BOT_USERNAME=your_bot_username

# === MongoDB ===
MONGODB_URI=mongodb://localhost:27017/ai-telegram-bot

# === Admin ===
ADMIN_IDS=123456789,987654321
ADMIN_PASSWORD=your_admin_panel_password

# === AI Providers ===
# Google Gemini (free tier: 15 RPM, 1M tokens/month)
GEMINI_API_KEY=your_gemini_api_key
# OpenAI-compatible fallback (optional)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# === Image Generation ===
# Pollinations.ai is used by default (free, no key needed)
# HuggingFace as fallback (optional)
HUGGINGFACE_API_KEY=

# === Voice ===
# Wit.ai for Speech-to-Text (free: 200 req/min)
WIT_AI_TOKEN=your_wit_ai_token

# === Media Download ===
# Cobalt API (default: free public instance)
COBALT_API_URL=https://api.cobalt.tools
# Google cookies file path for age-restricted videos (optional)
GOOGLE_COOKIES_PATH=

# === Forced Subscription ===
# Comma-separated channel usernames (without @)
REQUIRED_CHANNELS=your_channel1,your_channel2

# === Success Video ===
# URL or file_id of video shown on successful operations
SUCCESS_VIDEO_URL=

# === Server ===
PORT=3000
NODE_ENV=production

# === Rate Limiting ===
MAX_REQUESTS_PER_MINUTE=20
